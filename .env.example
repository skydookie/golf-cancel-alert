# PostgreSQL connection string (free tier: Neon, Supabase, Railway 등)
DATABASE_URL="postgresql://user:password@host:5432/golf_cancel_alert"

# 세션 쿠키 서명용 비밀키 (openssl rand -hex 32 등으로 생성)
SESSION_SECRET="change-me-to-a-long-random-string"

# 골프장 계정 비밀번호 가역 암호화 키 (32바이트를 base64로 인코딩한 값 — openssl rand -base64 32)
CREDENTIAL_ENCRYPTION_KEY="change-me-to-a-base64-32-byte-key"

# 웹푸시 VAPID 키 (npx web-push generate-vapid-keys 로 생성)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# 스케줄러(cron)가 /api/cron/scan 을 호출할 때 쓰는 비밀 토큰 — GitHub Actions secret에도 동일하게 설정
CRON_SECRET="change-me-to-a-long-random-string"

# 회원가입에 필요한 초대코드 (실행 단계에 정한 단순한 공용 코드 방식 — 나중에 여러 개로 확장 가능)
INVITE_CODE="change-me"
